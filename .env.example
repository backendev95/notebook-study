# Copia este archivo como .env para desarrollo local.
# Supabase → Project Settings → API (o Data API / API Keys)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La "publishable key" (o la "anon public key" en proyectos más antiguos). Es pública por diseño:
# la seguridad la dan las políticas RLS de supabase/schema.sql. NUNCA pongas aquí la service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
